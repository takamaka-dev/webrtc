import("../../webrtc.gni")

group("crypto") {
  deps = [
    ":frame_decryptor_interface",
    ":frame_encryptor_interface",
    ":options",
  ]
}

rtc_library("frame_crypto_transformer") {
  visibility = [ "*" ]
  sources = [
    "frame_crypto_transformer.cc",
    "frame_crypto_transformer.h",
  ]

  deps = [
   "//api:frame_transformer_interface",
  ]

  if (rtc_build_ssl) {
    deps += [ "//third_party/boringssl" ]
  } else {
    configs += [ ":external_ssl_library" ]
  }
}

# C182 / DR-055 (Takamaka): RFC 9605 SFrame transformer, suite 5, fail closed.
# Shares nothing with frame_crypto_transformer above.
rtc_library("sframe_transformer") {
  visibility = [ "*" ]
  sources = [
    "sframe_core.cc",
    "sframe_core.h",
    "sframe_transformer.cc",
    "sframe_transformer.h",
  ]
  deps = [
    "..:frame_transformer_interface",
    "..:make_ref_counted",
    "..:ref_count",
    "..:scoped_refptr",
    "../../common_video",
    "../../rtc_base:bitstream_reader",
    "../../rtc_base:checks",
    "../../rtc_base:macromagic",
    "../../rtc_base/synchronization:mutex",
    "../../rtc_base/system:rtc_export",
    "../../system_wrappers",
    "../units:time_delta",
    "../units:timestamp",
  ]
  if (rtc_build_ssl) {
    deps += [ "//third_party/boringssl" ]
  } else {
    configs += [ ":external_ssl_library" ]
  }
}

rtc_library("options") {
  visibility = [ "*" ]
  sources = [
    "crypto_options.cc",
    "crypto_options.h",
  ]
  deps = [
    "..:field_trials_view",
    "../../rtc_base:checks",
    "../../rtc_base:ssl_adapter",
    "../../rtc_base/system:rtc_export",
    "//third_party/abseil-cpp/absl/algorithm:container",
  ]
}

rtc_source_set("frame_decryptor_interface") {
  visibility = [ "*" ]
  sources = [ "frame_decryptor_interface.h" ]
  deps = [
    "..:ref_count",
    "..:rtp_parameters",
  ]
}

rtc_source_set("frame_encryptor_interface") {
  visibility = [ "*" ]
  sources = [ "frame_encryptor_interface.h" ]
  deps = [
    "..:ref_count",
    "..:rtp_parameters",
  ]
}

if (rtc_include_tests) {
  rtc_library("crypto_options_unittest") {
    visibility = [ "*" ]
    testonly = true
    sources = [ "crypto_options_unittest.cc" ]
    deps = [
      ":options",
      "..:field_trials",
      "../../rtc_base:ssl_adapter",
      "../../test:create_test_field_trials",
      "../../test:test_support",
      "//testing/gtest",
    ]
    if (rtc_build_ssl) {
      deps += [ "//third_party/boringssl" ]
    }
  }
  # C182 / DR-055: `ninja -C out/<dir> sframe_unittests` (host). Vectors:
  # sframe_test_vectors.inc, generated by sframe_gen_test_vectors.py from the
  # Java reference vectors and RFC 9605 Appendix C.
  rtc_test("sframe_unittests") {
    testonly = true
    sources = [
      "sframe_core_unittest.cc",
      "sframe_test_vectors.inc",
      "sframe_transformer_unittest.cc",
    ]
    deps = [
      ":sframe_transformer",
      "..:frame_transformer_interface",
      "..:make_ref_counted",
      "..:mock_transformable_audio_frame",
      "..:mock_transformable_video_frame",
      "../../common_video",
      "../../modules/rtp_rtcp",
      "../../modules/rtp_rtcp:rtp_rtcp_format",
      "../../modules/video_coding",
      "../../system_wrappers",
      "../../test:test_main",
      "../../test:test_support",
      "../units:time_delta",
      "../units:timestamp",
      "//testing/gtest",
    ]
  }

  rtc_library("crypto_unittests") {
    testonly = true
    sources = [
      "frame_crypto_transformer_unittest.cc",
      "sif_payload_unittest.cc",
    ]
    deps = [
      ":crypto",
      ":frame_crypto_transformer",
      "//testing/gtest",
      "//third_party/boringssl",
      "../../api:mock_transformable_video_frame",
      "../../rtc_base:rtc_event",
      "../../rtc_base:threading",
      "../../test:test_support",
    ]
  }
}
